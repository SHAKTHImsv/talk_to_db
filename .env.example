# Backend (server-side only, loaded by python-dotenv)
GROQ_API_KEY=your_groq_api_key_here
# meta-llama/llama-prompt-guard-2-22m = classifier (scores prompts, no SQL generation)
# llama-3.1-8b-instant = generates SQL from natural-language prompts
GROQ_MODEL=meta-llama/llama-prompt-guard-2-22m

# Frontend (Vite - only VITE_-prefixed vars are exposed to the browser)
VITE_API_URL=http://localhost:8000
